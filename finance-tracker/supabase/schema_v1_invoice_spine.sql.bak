-- ============================================================================
--  Ledger - Finance and Project Tracker — Database Schema
--  Postgres (Supabase). Owner-scoped, RLS-protected.
--
--  Mental model:
--    YOU are the root. Everything hangs off owner_id (auth.uid()).
--    CLIENT ──< INVOICE >── PROJECT
--    An invoice is the ONLY object that carries money.
--    Dashboards are just filtered SUMs over invoices + expenses.
-- ============================================================================

-- ---------- Extensions ----------
create extension if not exists "pgcrypto";

-- ============================================================================
--  CLIENTS  (parties you transact with — Acme Studios is just one row here)
--  "Personal" is modelled as project.client_id = NULL, so no dummy client row.
-- ============================================================================
create table public.clients (
  id                uuid primary key default gen_random_uuid(),
  owner_id          uuid not null references auth.users(id) on delete cascade,
  name              text not null,
  -- Per-context invoice numbering. e.g. 'ACME' -> ACME/25-26/0001
  invoice_prefix    text not null,
  -- THEIR tax identity (not yours). Nullable — many clients won't have these.
  gstin             text,
  pan               text,
  billing_address   text,
  email             text,
  phone             text,
  notes             text,
  created_at        timestamptz not null default now(),
  unique (owner_id, invoice_prefix)
);

-- ============================================================================
--  PROJECTS  (lightweight parent — only deep enough to track money flow)
--  client_id NULL  => a personal project.
-- ============================================================================
create table public.projects (
  id                uuid primary key default gen_random_uuid(),
  owner_id          uuid not null references auth.users(id) on delete cascade,
  client_id         uuid references public.clients(id) on delete set null,
  name              text not null,
  status            text not null default 'active'
                      check (status in ('active','on_hold','completed','archived')),
  -- Optional agreed value, for progress bars (billed vs agreed).
  agreed_value      numeric(14,2),
  currency          text not null default 'INR',
  start_date        date,
  end_date          date,
  notes             text,
  created_at        timestamptz not null default now()
);

-- ============================================================================
--  MILESTONES  (only so-deep: a checkpoint that may map to a billing event)
-- ============================================================================
create table public.milestones (
  id                uuid primary key default gen_random_uuid(),
  owner_id          uuid not null references auth.users(id) on delete cascade,
  project_id        uuid not null references public.projects(id) on delete cascade,
  title             text not null,
  amount            numeric(14,2),           -- expected money for this milestone
  due_date          date,
  is_done           boolean not null default false,
  sort_order        int not null default 0,
  created_at        timestamptz not null default now()
);

-- ============================================================================
--  INVOICES  (the money spine)
--    direction = 'receivable'  -> money coming TO you (you issued it)
--    direction = 'payable'     -> money you OWE (a vendor billed you, e.g. Amita)
--    status flow: draft -> sent -> paid  (or -> overdue by date logic)
-- ============================================================================
create table public.invoices (
  id                uuid primary key default gen_random_uuid(),
  owner_id          uuid not null references auth.users(id) on delete cascade,

  -- Human-facing, gap-free, per-context number: e.g. ACME/25-26/0001
  invoice_number    text not null,
  fin_year          text not null,           -- '25-26'
  seq               int  not null,           -- 1, 2, 3 ... (per prefix+fy)
  prefix            text not null,           -- snapshot of client prefix at issue

  direction         text not null default 'receivable'
                      check (direction in ('receivable','payable')),

  client_id         uuid references public.clients(id) on delete set null,
  project_id        uuid references public.projects(id) on delete set null,

  status            text not null default 'draft'
                      check (status in ('draft','sent','paid','overdue','cancelled')),

  issue_date        date not null default current_date,
  due_date          date,
  paid_date         date,

  -- Money. tax fields kept for future GST; default 0 (you invoice w/o GST today).
  currency          text not null default 'INR',
  subtotal          numeric(14,2) not null default 0,
  discount          numeric(14,2) not null default 0,
  tax_rate          numeric(5,2)  not null default 0,
  tax_amount        numeric(14,2) not null default 0,
  total             numeric(14,2) not null default 0,

  -- "Billed By" snapshot (YOUR details, or vendor's for payables).
  billed_by         jsonb,     -- {name, address, email, phone, pan}
  bank_details      jsonb,     -- {account_name, account_number, ifsc, bank, upi}

  notes             text,
  terms             text,
  created_at        timestamptz not null default now(),

  unique (owner_id, invoice_number)
);

create index on public.invoices (owner_id, status);
create index on public.invoices (owner_id, direction);
create index on public.invoices (owner_id, issue_date);
create index on public.invoices (project_id);
create index on public.invoices (client_id);

-- ============================================================================
--  INVOICE LINE ITEMS
-- ============================================================================
create table public.invoice_items (
  id                uuid primary key default gen_random_uuid(),
  invoice_id        uuid not null references public.invoices(id) on delete cascade,
  description       text not null,
  quantity          numeric(12,2) not null default 1,
  rate              numeric(14,2) not null default 0,
  amount            numeric(14,2) not null default 0,   -- quantity * rate
  sort_order        int not null default 0
);
create index on public.invoice_items (invoice_id);

-- ============================================================================
--  EXPENSES  (money out that isn't a vendor invoice — travel, tools, etc.)
-- ============================================================================
create table public.expenses (
  id                uuid primary key default gen_random_uuid(),
  owner_id          uuid not null references auth.users(id) on delete cascade,
  project_id        uuid references public.projects(id) on delete set null,
  category          text,
  description       text,
  amount            numeric(14,2) not null default 0,
  currency          text not null default 'INR',
  spent_on          date not null default current_date,
  created_at        timestamptz not null default now()
);
create index on public.expenses (owner_id, spent_on);

-- ============================================================================
--  SUBSCRIPTIONS  (V2 — Gmail-fed recurring expenses; manual entry works now)
-- ============================================================================
create table public.subscriptions (
  id                uuid primary key default gen_random_uuid(),
  owner_id          uuid not null references auth.users(id) on delete cascade,
  name              text not null,
  amount            numeric(14,2) not null default 0,
  currency          text not null default 'INR',
  cadence           text not null default 'monthly'
                      check (cadence in ('monthly','quarterly','yearly','weekly')),
  next_renewal      date,
  is_active         boolean not null default true,
  source            text not null default 'manual'    -- 'manual' | 'gmail'
                      check (source in ('manual','gmail')),
  created_at        timestamptz not null default now()
);

-- ============================================================================
--  MY PROFILE  (your default "Billed By" + bank details, one row per user)
-- ============================================================================
create table public.profiles (
  id                uuid primary key references auth.users(id) on delete cascade,
  full_name         text,
  email             text,
  phone             text,
  pan               text,
  address           text,
  default_bank      jsonb,   -- {account_name, account_number, ifsc, bank, upi}
  created_at        timestamptz not null default now()
);

-- ============================================================================
--  GAP-FREE INVOICE NUMBER GENERATOR
--  Locks the counter row, increments per (prefix, fin_year), returns next number.
--  Called inside the invoice-create transaction so two invoices can't collide.
-- ============================================================================
create table public.invoice_counters (
  owner_id          uuid not null references auth.users(id) on delete cascade,
  prefix            text not null,
  fin_year          text not null,
  last_seq          int  not null default 0,
  primary key (owner_id, prefix, fin_year)
);

create or replace function public.next_invoice_number(
  p_prefix   text,
  p_fin_year text
) returns table (invoice_number text, seq int, fin_year text)
language plpgsql
security definer
set search_path = public
as $$
declare
  v_uid uuid := auth.uid();
  v_seq int;
begin
  insert into public.invoice_counters (owner_id, prefix, fin_year, last_seq)
    values (v_uid, p_prefix, p_fin_year, 0)
    on conflict (owner_id, prefix, fin_year) do nothing;

  update public.invoice_counters
    set last_seq = last_seq + 1
    where owner_id = v_uid and prefix = p_prefix and fin_year = p_fin_year
    returning last_seq into v_seq;

  return query select
    p_prefix || '/' || p_fin_year || '/' || lpad(v_seq::text, 4, '0'),
    v_seq,
    p_fin_year;
end;
$$;

-- ============================================================================
--  DASHBOARD VIEW  (pre-aggregated money flow, owner-scoped)
-- ============================================================================
create or replace view public.v_dashboard_totals as
select
  owner_id,
  -- INBOUND: receivables you've sent, not yet paid
  coalesce(sum(total) filter (where direction='receivable' and status='sent'),0)
    as inbound,
  -- TO BE PAID: payables (you owe vendors), not yet paid
  coalesce(sum(total) filter (where direction='payable' and status in ('sent','draft')),0)
    as to_be_paid,
  -- EARNINGS: receivables actually paid
  coalesce(sum(total) filter (where direction='receivable' and status='paid'),0)
    as earnings,
  -- OVERDUE receivables
  coalesce(sum(total) filter (where direction='receivable'
      and status='sent' and due_date < current_date),0)
    as overdue
from public.invoices
group by owner_id;

-- ============================================================================
--  ROW LEVEL SECURITY  (every table: you can only see your own rows)
-- ============================================================================
alter table public.clients        enable row level security;
alter table public.projects       enable row level security;
alter table public.milestones     enable row level security;
alter table public.invoices       enable row level security;
alter table public.invoice_items  enable row level security;
alter table public.expenses       enable row level security;
alter table public.subscriptions  enable row level security;
alter table public.profiles       enable row level security;
alter table public.invoice_counters enable row level security;

-- Generic owner policies
create policy own_clients        on public.clients       using (owner_id = auth.uid()) with check (owner_id = auth.uid());
create policy own_projects       on public.projects      using (owner_id = auth.uid()) with check (owner_id = auth.uid());
create policy own_milestones     on public.milestones    using (owner_id = auth.uid()) with check (owner_id = auth.uid());
create policy own_invoices       on public.invoices      using (owner_id = auth.uid()) with check (owner_id = auth.uid());
create policy own_expenses       on public.expenses      using (owner_id = auth.uid()) with check (owner_id = auth.uid());
create policy own_subscriptions  on public.subscriptions using (owner_id = auth.uid()) with check (owner_id = auth.uid());
create policy own_profile        on public.profiles      using (id = auth.uid()) with check (id = auth.uid());
create policy own_counters       on public.invoice_counters using (owner_id = auth.uid()) with check (owner_id = auth.uid());

-- invoice_items inherit access via their parent invoice
create policy own_invoice_items on public.invoice_items
  using (exists (select 1 from public.invoices i
                 where i.id = invoice_id and i.owner_id = auth.uid()))
  with check (exists (select 1 from public.invoices i
                 where i.id = invoice_id and i.owner_id = auth.uid()));
