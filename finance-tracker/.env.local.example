# Copy this file to .env.local and fill in the two values below.
# Find them in Supabase: Project Settings -> API.
#
# Both are SAFE to expose to the browser (the anon key is public by design;
# your data is protected by Row Level Security in supabase/schema.sql).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# NEVER add your Supabase service_role key here or in Vercel. This app does
# not need it, and it bypasses every Row Level Security policy.
